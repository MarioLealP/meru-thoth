{
  "components": {
    "schemas": {
      "Catalog": {
        "description": "Every item and relation type, by name.",
        "examples": [
          {
            "items": {
              "host": {
                "description": "An operating system instance.",
                "key_pattern": "^[a-z0-9-]+$",
                "schema": {}
              }
            },
            "relations": {
              "mounts": {
                "description": "A workload mounts a volume.",
                "from": [
                  "workload"
                ],
                "schema": {},
                "to": [
                  "volume"
                ]
              }
            }
          }
        ],
        "properties": {
          "items": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ItemTypeOut"
            },
            "examples": [
              {
                "host": {
                  "description": "An operating system instance.",
                  "key_pattern": "^[a-z0-9-]+$",
                  "schema": {}
                }
              }
            ],
            "title": "Items",
            "type": "object"
          },
          "relations": {
            "additionalProperties": {
              "$ref": "#/components/schemas/RelationTypeOut"
            },
            "examples": [
              {
                "mounts": {
                  "description": "A workload mounts a volume.",
                  "from": [
                    "workload"
                  ],
                  "schema": {},
                  "to": [
                    "volume"
                  ]
                }
              }
            ],
            "title": "Relations",
            "type": "object"
          }
        },
        "required": [
          "items",
          "relations"
        ],
        "title": "Catalog",
        "type": "object"
      },
      "Health": {
        "description": "Thoth's state.",
        "properties": {
          "status": {
            "default": "ok",
            "examples": [
              "ok"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "title": "Health",
        "type": "object"
      },
      "ItemTypeOut": {
        "description": "An item type.",
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "key_pattern": {
            "examples": [
              "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
            ],
            "title": "Key Pattern",
            "type": "string"
          },
          "schema": {
            "additionalProperties": true,
            "examples": [
              {
                "properties": {
                  "os": {
                    "x-owners": [
                      "host-scan"
                    ]
                  }
                }
              }
            ],
            "title": "Schema",
            "type": "object"
          }
        },
        "required": [
          "description",
          "key_pattern",
          "schema"
        ],
        "title": "ItemTypeOut",
        "type": "object"
      },
      "Problem": {
        "description": "What went wrong (RFC 9457 problem details).",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "no host with key 'clockmost'"
            ],
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              [
                {
                  "loc": [
                    "body",
                    "key"
                  ],
                  "msg": "Field required",
                  "type": "missing"
                }
              ]
            ],
            "title": "Errors"
          },
          "status": {
            "examples": [
              404
            ],
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "examples": [
              "Not Found"
            ],
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "examples": [
              "about:blank"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status"
        ],
        "title": "Problem",
        "type": "object"
      },
      "RelationTypeOut": {
        "description": "A relation type: which item types may sit at each end (`*` = any).",
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "from": {
            "examples": [
              [
                "workload"
              ]
            ],
            "items": {
              "type": "string"
            },
            "title": "From",
            "type": "array"
          },
          "schema": {
            "additionalProperties": true,
            "examples": [
              {
                "properties": {
                  "path": {
                    "x-owners": [
                      "k8s-scan"
                    ]
                  }
                }
              }
            ],
            "title": "Schema",
            "type": "object"
          },
          "to": {
            "examples": [
              [
                "volume"
              ]
            ],
            "items": {
              "type": "string"
            },
            "title": "To",
            "type": "array"
          }
        },
        "required": [
          "description",
          "from",
          "to",
          "schema"
        ],
        "title": "RelationTypeOut",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Items (hosts, apps, accounts, volumes...), the typed relations between them, and every earlier version of both. The only way to write to Thoth: each write names an actor and a reason, and nothing is deleted.",
    "license": {
      "identifier": "MIT",
      "name": "MIT"
    },
    "summary": "Meru's CMDB: what exists, how it connects, and how it got that way.",
    "title": "Thoth",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/heartbeat": {
      "get": {
        "description": "Liveness: the process answers. Says nothing about the database.",
        "operationId": "heartbeat",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "example": {
                  "status": 404,
                  "title": "Not Found",
                  "type": "about:blank"
                }
              }
            },
            "description": "Any error, as problem details."
          }
        },
        "summary": "Heartbeat",
        "tags": [
          "health"
        ]
      }
    },
    "/ready": {
      "get": {
        "description": "Readiness: the database answers, and (checked once per process) every stored row fits this version's catalog.\n\nOnly then is the catalog copied into its tables - so a version whose catalog change left misfit rows never\ngoes live, and the old one keeps serving.",
        "operationId": "ready",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "example": {
                  "status": 404,
                  "title": "Not Found",
                  "type": "about:blank"
                }
              }
            },
            "description": "Any error, as problem details."
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/catalog": {
      "get": {
        "description": "Every item and relation type: description, key pattern (items), allowed ends (relations), and the JSON Schema\nof its attributes - each field's `x-owners` lists the sources that may report it, first one wins.",
        "operationId": "get_catalog",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalog"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "example": {
                  "status": 404,
                  "title": "Not Found",
                  "type": "about:blank"
                }
              }
            },
            "description": "Any error, as problem details."
          }
        },
        "summary": "Get Catalog",
        "tags": [
          "catalog"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "clockmost",
      "url": "https://thoth.clockmost.com"
    }
  ],
  "tags": [
    {
      "description": "Is Thoth up.",
      "name": "health"
    },
    {
      "description": "Which item and relation types exist, and what they hold.",
      "name": "catalog"
    }
  ]
}
