{
  "components": {
    "schemas": {
      "Catalog": {
        "description": "Every item and relation type, by name.",
        "examples": [
          {
            "items": {
              "host": {
                "description": "An operating system instance.",
                "key_pattern": "^[a-z0-9-]+$",
                "schema": {}
              }
            },
            "relations": {
              "mounts": {
                "description": "A workload mounts a volume.",
                "from": [
                  "workload"
                ],
                "schema": {},
                "to": [
                  "volume"
                ]
              }
            }
          }
        ],
        "properties": {
          "items": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ItemTypeOut"
            },
            "examples": [
              {
                "host": {
                  "description": "An operating system instance.",
                  "key_pattern": "^[a-z0-9-]+$",
                  "schema": {}
                }
              }
            ],
            "title": "Items",
            "type": "object"
          },
          "relations": {
            "additionalProperties": {
              "$ref": "#/components/schemas/RelationTypeOut"
            },
            "examples": [
              {
                "mounts": {
                  "description": "A workload mounts a volume.",
                  "from": [
                    "workload"
                  ],
                  "schema": {},
                  "to": [
                    "volume"
                  ]
                }
              }
            ],
            "title": "Relations",
            "type": "object"
          }
        },
        "required": [
          "items",
          "relations"
        ],
        "title": "Catalog",
        "type": "object"
      },
      "Health": {
        "description": "Thoth's state.",
        "properties": {
          "status": {
            "default": "ok",
            "examples": [
              "ok"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "title": "Health",
        "type": "object"
      },
      "ItemTypeOut": {
        "description": "An item type.",
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "key_pattern": {
            "examples": [
              "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
            ],
            "title": "Key Pattern",
            "type": "string"
          },
          "schema": {
            "additionalProperties": true,
            "examples": [
              {
                "properties": {
                  "os": {
                    "x-owners": [
                      "host-scan"
                    ]
                  }
                }
              }
            ],
            "title": "Schema",
            "type": "object"
          }
        },
        "required": [
          "description",
          "key_pattern",
          "schema"
        ],
        "title": "ItemTypeOut",
        "type": "object"
      },
      "Problem": {
        "description": "What went wrong (RFC 9457 problem details).",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "no host with key 'clockmost'"
            ],
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              [
                {
                  "loc": [
                    "body",
                    "key"
                  ],
                  "msg": "Field required",
                  "type": "missing"
                }
              ]
            ],
            "title": "Errors"
          },
          "status": {
            "examples": [
              404
            ],
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "examples": [
              "Not Found"
            ],
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "examples": [
              "about:blank"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status"
        ],
        "title": "Problem",
        "type": "object"
      },
      "RelationTypeOut": {
        "description": "A relation type: which item types may sit at each end (`*` = any).",
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "from": {
            "examples": [
              [
                "workload"
              ]
            ],
            "items": {
              "type": "string"
            },
            "title": "From",
            "type": "array"
          },
          "schema": {
            "additionalProperties": true,
            "examples": [
              {
                "properties": {
                  "path": {
                    "x-owners": [
                      "k8s-scan"
                    ]
                  }
                }
              }
            ],
            "title": "Schema",
            "type": "object"
          },
          "to": {
            "examples": [
              [
                "volume"
              ]
            ],
            "items": {
              "type": "string"
            },
            "title": "To",
            "type": "array"
          }
        },
        "required": [
          "description",
          "from",
          "to",
          "schema"
        ],
        "title": "RelationTypeOut",
        "type": "object"
      },
      "ReportedItem": {
        "description": "One thing, as a source sees it.",
        "properties": {
          "attributes": {
            "additionalProperties": true,
            "examples": [
              {
                "email": "lealmariop@gmail.com"
              }
            ],
            "title": "Attributes",
            "type": "object"
          },
          "key": {
            "examples": [
              "linux/clockmost-desktop/benylin"
            ],
            "title": "Key",
            "type": "string"
          },
          "name": {
            "examples": [
              "benylin"
            ],
            "title": "Name",
            "type": "string"
          },
          "type": {
            "examples": [
              "account"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "key",
          "name",
          "attributes"
        ],
        "title": "ReportedItem",
        "type": "object"
      },
      "Snapshot": {
        "description": "Everything a source sees from one scope - its whole picture, not a diff.",
        "properties": {
          "items": {
            "examples": [
              [
                {
                  "attributes": {
                    "kind": "physical",
                    "os": "CachyOS"
                  },
                  "key": "clockmost-desktop",
                  "name": "clockmost-desktop",
                  "type": "host"
                },
                {
                  "attributes": {
                    "email": "lealmariop@gmail.com"
                  },
                  "key": "linux/clockmost-desktop/benylin",
                  "name": "benylin",
                  "type": "account"
                }
              ]
            ],
            "items": {
              "$ref": "#/components/schemas/ReportedItem"
            },
            "maxItems": 20000,
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "Snapshot",
        "type": "object"
      },
      "SnapshotRunOut": {
        "description": "A source's latest snapshot: when, and whether it was accepted (with counts) or refused (with reasons).",
        "properties": {
          "accepted": {
            "title": "Accepted",
            "type": "boolean"
          },
          "at": {
            "format": "date-time",
            "title": "At",
            "type": "string"
          },
          "scope": {
            "examples": [
              "clockmost-desktop"
            ],
            "title": "Scope",
            "type": "string"
          },
          "source": {
            "examples": [
              "host-scan"
            ],
            "title": "Source",
            "type": "string"
          },
          "summary": {
            "additionalProperties": true,
            "examples": [
              {
                "changed": 1,
                "created": 0,
                "for_anubis": [],
                "missed": 0,
                "unchanged": 40
              }
            ],
            "title": "Summary",
            "type": "object"
          }
        },
        "required": [
          "source",
          "scope",
          "at",
          "accepted",
          "summary"
        ],
        "title": "SnapshotRunOut",
        "type": "object"
      },
      "Source": {
        "description": "Everything that may write to Thoth. Each writes with its own identity, and only its slice.",
        "enum": [
          "shikigami",
          "manual",
          "authentik-sync",
          "gitea-sync",
          "host-scan",
          "k8s-scan",
          "r7000-scan",
          "caddy-scan"
        ],
        "title": "Source",
        "type": "string"
      },
      "Summary": {
        "description": "What a snapshot changed.",
        "properties": {
          "changed": {
            "examples": [
              2
            ],
            "title": "Changed",
            "type": "integer"
          },
          "created": {
            "examples": [
              1
            ],
            "title": "Created",
            "type": "integer"
          },
          "for_anubis": {
            "examples": [
              [
                "account linux/clockmost-desktop/olduser"
              ]
            ],
            "items": {
              "type": "string"
            },
            "title": "For Anubis",
            "type": "array"
          },
          "missed": {
            "examples": [
              1
            ],
            "title": "Missed",
            "type": "integer"
          },
          "unchanged": {
            "examples": [
              40
            ],
            "title": "Unchanged",
            "type": "integer"
          }
        },
        "required": [
          "created",
          "changed",
          "unchanged",
          "missed",
          "for_anubis"
        ],
        "title": "Summary",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Items (hosts, apps, accounts, volumes...), the typed relations between them, and every earlier version of both. The only way to write to Thoth: each write names an actor and a reason, and nothing is deleted.",
    "license": {
      "identifier": "MIT",
      "name": "MIT"
    },
    "summary": "Meru's CMDB: what exists, how it connects, and how it got that way.",
    "title": "Thoth",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/heartbeat": {
      "get": {
        "description": "Liveness: the process answers. Says nothing about the database.",
        "operationId": "heartbeat",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "example": {
                  "status": 404,
                  "title": "Not Found",
                  "type": "about:blank"
                }
              }
            },
            "description": "Any error, as problem details."
          }
        },
        "summary": "Heartbeat",
        "tags": [
          "health"
        ]
      }
    },
    "/ready": {
      "get": {
        "description": "Readiness: the database answers, and (checked once per process) every stored row fits this version's catalog.\n\nOnly then is the catalog copied into its tables - so a version whose catalog change left misfit rows never\ngoes live, and the old one keeps serving.",
        "operationId": "ready",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "example": {
                  "status": 404,
                  "title": "Not Found",
                  "type": "about:blank"
                }
              }
            },
            "description": "Any error, as problem details."
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/catalog": {
      "get": {
        "description": "Every item and relation type: description, key pattern (items), allowed ends (relations), and the JSON Schema\nof its attributes - each field's `x-owners` lists the sources that may report it, first one wins.",
        "operationId": "get_catalog",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalog"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "example": {
                  "status": 404,
                  "title": "Not Found",
                  "type": "about:blank"
                }
              }
            },
            "description": "Any error, as problem details."
          }
        },
        "summary": "Get Catalog",
        "tags": [
          "catalog"
        ]
      }
    },
    "/v1/snapshots": {
      "get": {
        "description": "The latest snapshot of every source + scope - Zabbix watches this for refused or stale sources.",
        "operationId": "list_snapshots",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": [
                  {
                    "accepted": true,
                    "at": "2026-10-29T12:00:00Z",
                    "scope": "clockmost-desktop",
                    "source": "host-scan",
                    "summary": {
                      "changed": 1,
                      "created": 0,
                      "for_anubis": [],
                      "missed": 0,
                      "unchanged": 40
                    }
                  }
                ],
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SnapshotRunOut"
                  },
                  "title": "Response List Snapshots",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "example": {
                  "status": 404,
                  "title": "Not Found",
                  "type": "about:blank"
                }
              }
            },
            "description": "Any error, as problem details."
          }
        },
        "summary": "List Snapshots",
        "tags": [
          "snapshots"
        ]
      }
    },
    "/v1/snapshots/{source}/{scope}": {
      "put": {
        "description": "Report what `source` sees from `scope`. All or nothing: anything wrong refuses the whole snapshot and keeps\nthe last good data (every refusal is logged, for Zabbix). Things missing 3 snapshots in a row go to Anubis.",
        "operationId": "put_snapshot",
        "parameters": [
          {
            "description": "Who is reporting.",
            "in": "path",
            "name": "source",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Source",
              "description": "Who is reporting.",
              "examples": [
                "host-scan"
              ]
            }
          },
          {
            "description": "Where it looked: a machine or cluster name, or `all` for sources that see a whole system.",
            "in": "path",
            "name": "scope",
            "required": true,
            "schema": {
              "description": "Where it looked: a machine or cluster name, or `all` for sources that see a whole system.",
              "examples": [
                "clockmost-desktop"
              ],
              "maxLength": 63,
              "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
              "title": "Scope",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "items": [
                  {
                    "attributes": {
                      "kind": "physical",
                      "os": "CachyOS"
                    },
                    "key": "clockmost-desktop",
                    "name": "clockmost-desktop",
                    "type": "host"
                  },
                  {
                    "attributes": {
                      "email": "lealmariop@gmail.com"
                    },
                    "key": "linux/clockmost-desktop/benylin",
                    "name": "benylin",
                    "type": "account"
                  }
                ]
              },
              "schema": {
                "$ref": "#/components/schemas/Snapshot"
              }
            }
          },
          "description": "The source's whole picture from this scope.",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Summary"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "example": {
                  "status": 404,
                  "title": "Not Found",
                  "type": "about:blank"
                }
              }
            },
            "description": "Any error, as problem details."
          }
        },
        "summary": "Put Snapshot",
        "tags": [
          "snapshots"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "clockmost",
      "url": "https://thoth.clockmost.com"
    }
  ],
  "tags": [
    {
      "description": "Is Thoth up.",
      "name": "health"
    },
    {
      "description": "Which item and relation types exist, and what they hold.",
      "name": "catalog"
    },
    {
      "description": "Sources report what they see; Thoth works out what changed.",
      "name": "snapshots"
    }
  ]
}
